{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://cijmscjovgmvjcpayfoq.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "pro-new",
      "version": "0.2.0",
      "title": "pro new"
    },
    "tools": [
      {
        "name": "get_market_snapshot",
        "title": "Get market snapshot",
        "description": "Fetch a live Binance snapshot for a coin and timeframe: current price, 24h stats, EMA20/EMA50, RSI(14), swing high/low and the last candles. Works for spot and futures.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "minLength": 2,
              "description": "Coin or pair, e.g. BTC, BTCUSDT, SOLUSDT."
            },
            "timeframe": {
              "default": "1h",
              "description": "Binance interval such as 15m, 1h, 4h, 1d.",
              "type": "string"
            },
            "market": {
              "default": "spot",
              "description": "Binance market.",
              "type": "string",
              "enum": [
                "spot",
                "futures"
              ]
            }
          },
          "required": [
            "symbol"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_futures_data",
        "title": "Get futures positioning",
        "description": "Live perpetual futures positioning for a coin: mark price, funding rate and APR, open interest with 1h/4h/24h change, top-trader long/short ratio, taker buy/sell ratio and derived positioning signals.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "minLength": 2,
              "description": "Coin or pair, e.g. BTC, PEPEUSDT."
            }
          },
          "required": [
            "symbol"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_news_and_events",
        "title": "Get crypto news and economic events",
        "description": "Latest crypto news headlines (with source and time) and this week's economic calendar (FOMC, CPI, etc. with impact level). Optionally filter news by a keyword such as a coin name.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "keyword": {
              "description": "Optional filter, e.g. BTC, ETF, Solana.",
              "type": "string"
            },
            "newsLimit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "highImpactOnly": {
              "default": true,
              "description": "Only high-impact economic events.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "run_scanner",
        "title": "Run market scanner",
        "description": "Scan the top Binance USDT pairs by 24h volume on a timeframe and return coins matching setups: RSI oversold/overbought/bounce, volume spike, 20-candle breakout/breakdown, liquidity sweep reclaim/reject, trend. All listed setups must match. Results include price, RSI, EMAs, volume ratio and tags.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "timeframe": {
              "default": "1h",
              "description": "Binance interval: 5m, 15m, 1h, 4h, 1d.",
              "type": "string"
            },
            "setups": {
              "default": [
                "any"
              ],
              "description": "Setups that must all match. 'any' returns all scanned coins ranked.",
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "any",
                  "rsi_oversold",
                  "rsi_overbought",
                  "rsi_bounce",
                  "volume_spike",
                  "breakout_up",
                  "breakdown",
                  "bullish_sweep_reclaim",
                  "bearish_sweep_reject",
                  "uptrend",
                  "downtrend"
                ]
              }
            },
            "topN": {
              "default": 60,
              "description": "How many top-volume coins to scan.",
              "type": "integer",
              "minimum": 10,
              "maximum": 150
            },
            "maxResults": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_favorite_coins",
        "title": "List favorite coins",
        "description": "List the signed-in user's favorite coins saved in the scanner watchlist.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "add_favorite_coin",
        "title": "Add favorite coin",
        "description": "Add a coin to the signed-in user's favorite coins watchlist.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "minLength": 2,
              "description": "Coin or pair, e.g. SOL or SOLUSDT."
            }
          },
          "required": [
            "symbol"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "remove_favorite_coin",
        "title": "Remove favorite coin",
        "description": "Remove a coin from the signed-in user's favorite coins watchlist.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "minLength": 2,
              "description": "Coin or pair to remove, e.g. SOLUSDT."
            }
          },
          "required": [
            "symbol"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_trades",
        "title": "List trades",
        "description": "List the signed-in user's journaled trades, optionally filtered by status or symbol.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "default": "all",
              "description": "Filter by trade status.",
              "type": "string",
              "enum": [
                "open",
                "closed",
                "all"
              ]
            },
            "symbol": {
              "description": "Optional exact pair filter, e.g. BTCUSDT.",
              "type": "string"
            },
            "limit": {
              "default": 25,
              "description": "Maximum rows to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "log_trade",
        "title": "Log a trade",
        "description": "Record a new trade in the signed-in user's trade journal.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "minLength": 2,
              "description": "Pair, e.g. BTCUSDT."
            },
            "side": {
              "type": "string",
              "enum": [
                "long",
                "short"
              ],
              "description": "Trade direction."
            },
            "entry_price": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Entry price."
            },
            "quantity": {
              "default": 1,
              "description": "Position size.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "stop_loss": {
              "description": "Stop loss price.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "take_profit": {
              "description": "Take profit price.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "notes": {
              "description": "Trade rationale or notes.",
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "symbol",
            "side",
            "entry_price"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_saved_strategies",
        "title": "List saved strategies",
        "description": "List the signed-in user's saved scanner strategies with their conditions, timeframe and scan pool.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Maximum strategies to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
